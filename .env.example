# 复制为 .env 后填写真实值。注意 .env 已在 .gitignore / .dockerignore 中被排除。

# ---------- 被测 Agent / 裁判 LLM ----------
# 智谱 GLM 的 OpenAI 兼容端点。glm-4-plus 较贵且容易报余额不足，
# 日常用 glm-4.5-air（免费档还有 glm-4-flash / glm-4.5-flash）。
LLM_MODEL=glm-4.5-air
LLM_API_KEY=替换成你的智谱 API Key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 若使用 OpenAI，则改为：
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=

# ---------- Embedding ----------
# 缺省时复用 LLM_* 的密钥与端点
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---------- 数据库 ----------
# docker-compose 把 Postgres 映射到宿主 5432（admin/secret）；容器内会被 compose 覆盖为 db:5432
DATABASE_URL=postgresql+psycopg2://admin:secret@localhost:5432/agent_eval
AUTO_CREATE_SCHEMA=true
SQL_ECHO=false

# ---------- 评估阈值 / 权重 ----------
# RAG + 多工具的 Agent 一轮常在 15~30s，默认的 5s 会让延迟项恒为 0 分
DEFAULT_LATENCY_THRESHOLD=30
DEFAULT_COST_THRESHOLD=0.1
# 综合分权重，四项相加建议为 1.0
WEIGHT_QUALITY=0.3
WEIGHT_PERFORMANCE=0.2
WEIGHT_SECURITY=0.25
WEIGHT_TASK_COMPLETION=0.25

# ---------- 应用 ----------
# 端口不在 .env 里配：直接运行 app/main.py 默认 8010（8000 留给被测 Agent），
# 要换用命令行指定 PORT=xxxx python app/main.py
DEBUG=false
API_PREFIX=
